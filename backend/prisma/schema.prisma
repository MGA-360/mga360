// ============================================================================
// MGA 360 — Schema do banco de dados
// Espelha as regras de negócio da planilha original (ver MGA360-Arquitetura.md)
// Tudo que na planilha é FÓRMULA (branco/verde) NÃO vira coluna aqui — é
// sempre calculado em runtime pelo calc.service.ts. Só o que na planilha é
// CÉLULA AMARELA (entrada manual do usuário) vira coluna de tabela.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum FinanceEntryType {
  ENTRADA
  SAIDA
}

enum CostType {
  FIXO
  VARIAVEL
}

enum AssetCondition {
  OTIMO
  BOM
  REGULAR
  RUIM
}

enum CalendarStatus {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
}

enum DiagnosticModule {
  CADASTRO
  PLANEJAMENTO
  FINANCEIRO
  CUSTOS
  ESTOQUE
  PESSOAS
}

// ----------------------------------------------------------------------------
// Empresa (propriedade rural) e usuários
// ----------------------------------------------------------------------------

model Company {
  id                  String   @id @default(cuid())
  name                String // Nome da Propriedade
  ownerName           String // Proprietário / Gestor
  city                String?
  state               String? // UF
  totalAreaHa         Decimal? @db.Decimal(12, 2)
  productiveAreaHa    Decimal? @db.Decimal(12, 2)
  managementStartDate DateTime?
  activitiesSummary   String? // resumo livre (Cadastro §1)
  accessExpiresAt     DateTime? // controle de acesso da consultoria (ex: 90 dias); null = sem expiração; ADMIN nunca é bloqueado
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users            User[]
  memberships      CompanyMembership[]
  activities       Activity[]
  assets           Asset[]
  planningGoals    PlanningGoal[]
  planningCalendar PlanningCalendarItem[]
  productionCycles ProductionCycle[]
  financeEntries   FinanceEntry[]
  inventoryItems   InventoryItem[]
  employees        Employee[]
  progress         DiagnosticProgress[]
  reports          Report[]

  @@map("companies")
}

model User {
  id           String     @id @default(cuid())
  companyId    String? // empresa "ativa" no token atual — null p/ ADMIN, ou p/ CLIENT sem propriedade (ainda) ou com mais de uma
  company      Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(CLIENT)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships         CompanyMembership[]
  resetTokens         PasswordResetToken[]
  reportsGenerated    Report[]              @relation("ReportGeneratedBy")

  @@index([companyId])
  @@map("users")
}

// Vínculo N:N entre usuário e propriedade — um cliente pode ter várias
// propriedades (fazendas), e cada propriedade pode ter mais de um usuário
// vinculado no futuro (ex: sócio, gerente). companyId no User é sempre uma
// dessas linhas — a "ativa" no momento (definida no login/troca de propriedade).
model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@map("company_memberships")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// Cadastro — Módulo 1
// ----------------------------------------------------------------------------

// Lista de atividades da propriedade (Cadastro §2). É a fonte da verdade
// usada como dropdown em Financeiro, Planejamento e Decisão.
model Activity {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seqNumber   Int // Nº na planilha
  name        String // Atividade
  description String?

  planningGoals    PlanningGoal[]
  planningCalendar PlanningCalendarItem[]
  productionCycles ProductionCycle[]
  financeEntries   FinanceEntry[]

  @@unique([companyId, seqNumber])
  @@index([companyId])
  @@map("activities")
}

// Máquinas, equipamentos e estruturas (Cadastro §3)
model Asset {
  id                String          @id @default(cuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item              String
  type              String // Máquina, Equipamento, Estrutura...
  year              Int?
  acquisitionValue  Decimal?        @db.Decimal(14, 2)
  condition         AssetCondition?
  notes             String?
  createdAt         DateTime        @default(now())

  @@index([companyId])
  @@map("assets")
}

// ----------------------------------------------------------------------------
// Planejamento — Módulo 2
// ----------------------------------------------------------------------------

// Metas produtivas anuais (Planejamento §1). % Atingido é CALCULADO
// (achievedValue / annualGoal), nunca armazenado.
model PlanningGoal {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activityId    String
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  unit          String // Unidade de Medida (Litros, kg, cabeças...)
  annualGoal    Decimal  @db.Decimal(14, 2)
  achievedValue Decimal  @default(0) @db.Decimal(14, 2)
  notes         String?
  year          Int // permite metas por ano

  @@unique([activityId, year])
  @@index([companyId])
  @@map("planning_goals")
}

// Calendário de atividades mensal (Planejamento §2)
model PlanningCalendarItem {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month             Int // 1-12
  year              Int
  activityId        String?
  activity          Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  plannedActivity   String
  status            CalendarStatus @default(PLANEJADO)

  @@index([companyId, year, month])
  @@map("planning_calendar_items")
}

// Ciclos produtivos (Planejamento §3). Duração é CALCULADA (endDate - startDate).
model ProductionCycle {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  startDate  DateTime?
  endDate    DateTime?

  @@index([companyId])
  @@map("production_cycles")
}

// ----------------------------------------------------------------------------
// Financeiro — Módulo 3 (coração do sistema)
// ----------------------------------------------------------------------------

model FinanceEntry {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        FinanceEntryType
  date        DateTime
  description String
  category    String // livre em Entradas; nas Saídas deve bater com CostCategory.name
  activityId  String?
  activity    Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  value       Decimal          @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([companyId, type, date])
  @@map("finance_entries")
}

// Categorias fixas de custo (seed data, iguais para todas as empresas).
// cost_type é o que alimenta o cálculo de Ponto de Equilíbrio (Fixo x Variável).
model CostCategory {
  id       String   @id @default(cuid())
  name     String   @unique // Alimentação/Ração, Insumos, Medicamentos, Mão de obra, Energia, Manutenção, Outros Custos Operacionais
  costType CostType

  @@map("cost_categories")
}

// ----------------------------------------------------------------------------
// Estoque — Módulo 5
// ----------------------------------------------------------------------------

// Saldo Atual e Status são CALCULADOS (entryQty - exitQty; comparado a minStock)
model InventoryItem {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product    String
  category   String
  unit       String
  minStock   Decimal   @default(0) @db.Decimal(14, 2)
  expiryDate DateTime?
  entryQty   Decimal   @default(0) @db.Decimal(14, 2)
  exitQty    Decimal   @default(0) @db.Decimal(14, 2)
  updatedAt  DateTime  @updatedAt

  @@index([companyId])
  @@map("inventory_items")
}

// ----------------------------------------------------------------------------
// Pessoas — Módulo 6
// ----------------------------------------------------------------------------

// Custo Total é CALCULADO (baseSalary * (1 + chargesPct))
model Employee {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                String
  role                String
  baseSalary          Decimal  @db.Decimal(14, 2)
  chargesPct          Decimal  @default(0) @db.Decimal(5, 4) // ex 0.30 = 30%
  activitiesPerformed String?
  notes               String?

  @@index([companyId])
  @@map("employees")
}

// ----------------------------------------------------------------------------
// Progresso do diagnóstico (dashboard inicial: % concluído, módulos concluídos)
// ----------------------------------------------------------------------------

model DiagnosticProgress {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module         DiagnosticModule
  completionPct  Decimal          @default(0) @db.Decimal(5, 2) // 0-100
  lastUpdatedAt  DateTime         @updatedAt

  @@unique([companyId, module])
  @@map("diagnostic_progress")
}

// ----------------------------------------------------------------------------
// Relatórios (PDF)
// ----------------------------------------------------------------------------

// snapshotJson congela os números calculados no momento da geração, para o
// PDF não mudar retroativamente se os dados forem editados depois.
model Report {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generatedById String?
  generatedBy   User?    @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt   DateTime @default(now())
  fileUrl       String?
  snapshotJson  Json

  @@index([companyId])
  @@map("reports")
}
